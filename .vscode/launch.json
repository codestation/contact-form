{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["serve"]
    },
    {
      "name": "Go: migrate",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["migrate"]
    },
    {
      "name": "Go: migrate and seed",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["migrate", "--seed"]
    },
    {
      "name": "Go: rollback migration",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["migrate", "--rollback"]
    }
  ]
}
